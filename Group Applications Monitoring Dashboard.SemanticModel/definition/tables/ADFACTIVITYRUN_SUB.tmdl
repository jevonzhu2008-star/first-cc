table ADFACTIVITYRUN_SUB
	lineageTag: d733cae6-aa7b-42a1-bfe5-d60c5d53754c

	measure 'Data As Of SubActivity' =
			
			// var max_ = CALCULATE(MAX('API Job Log'[CREATE_TIME]),ALL('API Job Log'))
			var max_ = CALCULATE(MAX('ADFACTIVITYRUN_SUB'[CREATE_TIME]),ALL(ADFACTIVITYRUN_SUB))
			return CONCATENATE("Data As Of: UTC ",max_)
		lineageTag: 18ad2e10-c040-48c0-be78-c6bddbd41484

