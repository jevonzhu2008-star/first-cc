	partition ADFACTIVITYRUN_SUB = m
		mode: directQuery
		queryGroup: View
		source = ```
				let
				    Source = Sql.Database(P_Server, P_DB),
				    Custom1 = Value.NativeQuery(
				         Source,
				         "SELECT * FROM ["&P_Schema_DQ&"].[ADFACTIVITYRUN]  where CREATE_TIME >="&P_Interval&""
				         
				     )
				in
				    Custom1
				```

	annotation PBI_ResultType = Table

