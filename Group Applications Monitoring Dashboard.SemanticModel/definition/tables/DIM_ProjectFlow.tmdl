	column PROJECT_ID
		lineageTag: e3b89a80-4da4-4055-927c-f7c25e6b8e9a
		summarizeBy: none
		isNameInferred
		sourceColumn: V_SM_JOB_INFO_LOG_SNAP[PROJECT_ID]

		annotation SummarizationSetBy = Automatic

	partition DIM_ProjectFlow = calculated
		mode: import
		source = ```
				
				 FILTER(
				    ALL('V_SM_JOB_INFO_LOG_SNAP'[PROJECT_NAME],'V_SM_JOB_INFO_LOG_SNAP'[FLOW_NAME],V_SM_JOB_INFO_LOG_SNAP[PROJECT_ID]),
				   OR('V_SM_JOB_INFO_LOG_SNAP'[PROJECT_NAME] <> BLANK() ,
				    'V_SM_JOB_INFO_LOG_SNAP'[FLOW_NAME] <> BLANK()
				    )
				 )
				```

