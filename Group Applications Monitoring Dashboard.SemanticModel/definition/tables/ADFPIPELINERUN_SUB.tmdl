table ADFPIPELINERUN_SUB
	lineageTag: 200dcc85-cbce-4272-846e-b47634556c3c

	measure 'Data As Of SubPipeline' =
			
			// var max_ = CALCULATE(MAX('API Job Log'[CREATE_TIME]),ALL('API Job Log'))
			var max_ = CALCULATE(MAX('ADFPIPELINERUN_SUB'[CREATE_TIME]),ALL(ADFPIPELINERUN_SUB))
			return CONCATENATE("Data As Of: UTC ",max_)
