	partition ADFPIPELINERUN_SUB = m
		mode: directQuery
		queryGroup: View
		source = ```
				let
				    Source = Sql.Database(P_Server, P_DB),
				    Custom1 = Value.NativeQuery(
				         Source,
				         "SELECT * FROM ["&P_Schema_DQ&"].[ADFPIPELINERUN]  where CREATE_TIME >="&P_Interval&" and PREDECESSORS_PIPELINERUNID is not null"
				         
				     )
				in
				    Custom1
				```

	annotation PBI_ResultType = Exception

