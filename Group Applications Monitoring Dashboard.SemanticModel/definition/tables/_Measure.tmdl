	-- 失败作业计数（不含零）：不额外+0，用于特殊场景
	measure 'Failed_Jobs without0' = CALCULATE(COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Failed"))
		formatString: 0
