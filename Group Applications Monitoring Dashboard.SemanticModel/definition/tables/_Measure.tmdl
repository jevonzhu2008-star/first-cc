	-- 格式化总计划持续时间：将总秒数转换为"Xh Xm Xs"格式显示
	measure sum_v_s_durations = ```

			VAR DIF =SUM('V_SM_JOB_INFO_LOG_SNAP'[SCHEDULE_DURANTIONS]) + 0
			VAR HOURS = INT(DIF/3600)
			VAR MINUTES =INT(MOD(DIF ,3600 )/ 60)
			VAR SECONDS = MOD(DIF-MINUTES*60,3600)
			RETURN
			SWITCH(
			    TRUE(),
			    HOURS = 0 && MINUTES <> 0  ,MINUTES & "m" & SECONDS & "s",
			    HOURS = 0 && MINUTES = 0 , SECONDS & "s",
			    HOURS&"h" & MINUTES & "m" & SECONDS & "s"
			)
			```
		lineageTag: 44927177-e453-4d57-ada7-8c678345166a

	-- 钻取选择标识：如果当前日期等于最大AS_OF_DAY返回1，否则返回0
	measure drill_selection = ```
			VAR s_ = MAX('V_SM_JOB_INFO_LOG_SNAP'[AS_OF_DAY])
			RETURN
			IF(MAX('V_SM_SUB_JOB_INFO_LOG_SNAP'[AS_OF_DAY])= s_,1,0)
			```
		formatString: 0
		lineageTag: dec5a1ef-5dee-493a-8432-737bd2841b31

	-- 流程钻取选择标识：如果当前日期等于V_SM_FLOW_INFO_LOG_SNAP最大AS_OF_DAY返回1，否则返回0
	measure drill_selection_flow = ```
			VAR s_ = MAX('V_SM_FLOW_INFO_LOG_SNAP'[AS_OF_DAY])
			RETURN
			IF(MAX('V_SM_JOB_INFO_LOG_SNAP'[AS_OF_DAY])= s_,1,0)
			```
		formatString: 0
		lineageTag: 4c6a1540-07b8-4dc5-ac33-ceef8826d877

	-- 格式化流程总实际持续时间：将总秒数转换为"Xh Xm Xs"格式显示
	measure sum_Flow_durations = ```

			VAR DIF =SUM('V_SM_FLOW_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]) + 0
			VAR HOURS = INT(DIF/3600)
			VAR MINUTES =INT(MOD(DIF ,3600 )/ 60)
			VAR SECONDS = MOD(DIF-MINUTES*60,3600)
			RETURN
			SWITCH(
			    TRUE(),
			    HOURS = 0 && MINUTES <> 0  ,MINUTES & "m" & SECONDS & "s",
			    HOURS = 0 && MINUTES = 0 , SECONDS & "s",
			    HOURS&"h" & MINUTES & "m" & SECONDS & "s"
			)

			```
		lineageTag: 8a9358e9-33b7-40cc-a84b-63251635504e

	-- 格式化流程总计划持续时间：将总秒数转换为"Xh Xm Xs"格式显示
	measure sum_Flow_s_durations = ```

			VAR DIF =SUM('V_SM_FLOW_INFO_LOG_SNAP'[SCHEDULE_DURANTIONS]) + 0
			VAR HOURS = INT(DIF/3600)
			VAR MINUTES =INT(MOD(DIF ,3600 )/ 60)
			VAR SECONDS = MOD(DIF-MINUTES*60,3600)
			RETURN
			SWITCH(
			    TRUE(),
			    HOURS = 0 && MINUTES <> 0  ,MINUTES & "m" & SECONDS & "s",
			    HOURS = 0 && MINUTES = 0 , SECONDS & "s",
			    HOURS&"h" & MINUTES & "m" & SECONDS & "s"
			)
			//
			```
		lineageTag: d046a951-3535-43ae-91bf-3a671fe51f2c

	-- 按作业计算平均持续时间：转换为分钟单位
	measure AVG_by_job = CALCULATE(AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]),ALLSELECTED('V_SM_JOB_INFO_LOG_SNAP'[JOB_NAME]))/60
		lineageTag: 2652096d-c5c5-4958-a3a1-7d34a305d5b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	-- 重跑作业条件格式颜色：如果有重跑作业返回红色，否则返回深色背景
	measure 'Rerun Job_info_color' = ```

			VAR Rerun =
			CALCULATE(
			    COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),
			    'V_SM_JOB_INFO_LOG_SNAP'[Rerun tag] = "rerun"
			) + 0
			VAR Color = IF( Rerun <> 0 , "#cd3e32","#1f1d24")
			RETURN
			Color
			```
		lineageTag: 68d6eaf4-bf08-4799-bde0-41a948d04ad0

	-- 作业计数快照（不含零）：不额外+0，用于特殊场景
	measure 'Jobs_snap without 0' = COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID])
		formatString: 0
		lineageTag: 463ce272-3d81-4e53-8256-f649ab0098f2

	-- 来源标准差2（预留度量）
	measure Std_source_2
		lineageTag: cd417f19-0f5c-453d-b44d-e7c2db87eaa8

	-- 统计过期作业数量：筛选最新日期、当前流程、状态过期的作业去重计数
	measure expiration_jobs = CALCULATE(DISTINCTCOUNT(V_SM_JOB_INFO_LOG_SNAP[JOB_ID]),FILTER(V_SM_JOB_INFO_LOG_SNAP,V_SM_JOB_INFO_LOG_SNAP[FLOW_NAME]=MAX(DIM_ProjectFlow[FLOW_NAME])&&V_SM_JOB_INFO_LOG_SNAP[AS_OF_DAY]=MAX('DATE TABLE'[Date])&&V_SM_JOB_INFO_LOG_SNAP[LAST_AS_OF_FALG]="Y"&&V_SM_JOB_INFO_LOG_SNAP[STATUS]="Expiration"))+0
		formatString: 0
		lineageTag: c0981560-f981-431c-b659-58818cb152dd

	-- 统计重跑次数：统计Rerun Cycle > 1的作业计数
	measure rerun_times =

			CALCULATE(COUNT(V_SM_JOB_INFO_LOG_SNAP[JOB_ID]),FILTER(V_SM_JOB_INFO_LOG_SNAP,V_SM_JOB_INFO_LOG_SNAP[Rerun Cycle]>1
			))+0
		formatString: 0
		lineageTag: 0a23eca4-bd55-4e21-a356-c5d5d40acf05

	-- 最小开始条件判断：返回1如果当前作业ID等于最小开始时间对应的作业ID
	measure min_start_condition =
			VAR job_id = CALCULATE(MIN(V_SM_JOB_INFO_LOG_SNAP[JOB_ID]),FILTER(ALLSELECTED(V_SM_JOB_INFO_LOG_SNAP),V_SM_JOB_INFO_LOG_SNAP[START_TS]=[Min_start]))
			RETURN IF(SELECTEDVALUE(V_SM_JOB_INFO_LOG_SNAP[JOB_ID])=job_id,1)
		formatString: 0
		lineageTag: f7a631f1-3526-4217-ac00-8f391d27de23

	-- 运行中作业信息颜色：如果有符合条件的运行中作业返回蓝色，否则返回深色背景
	measure 'InProgress Job_info' =

			var info_=  CALCULATE(
			    COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),
			    FILTER(V_SM_JOB_INFO_LOG_SNAP,'V_SM_JOB_INFO_LOG_SNAP'[STATUS] = "InProgress" &&V_SM_JOB_INFO_LOG_SNAP[LAST_AS_OF_FALG]="Y"&&V_SM_JOB_INFO_LOG_SNAP[CONFLUENCE_NODE]<>"Y")
			) + 0
			RETURN IF(info_<>0,"#2A86CA","#1F1D24")
		lineageTag: ed401cc7-74f6-437c-959f-5ad93431c4f7

	-- 成功作业信息颜色：如果有符合条件的成功作业返回绿色，否则返回深色背景
	measure 'Succeeded Job_info' =

			var info_=  CALCULATE(
			    COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),
			    FILTER(V_SM_JOB_INFO_LOG_SNAP,'V_SM_JOB_INFO_LOG_SNAP'[STATUS] = "Succeeded" &&V_SM_JOB_INFO_LOG_SNAP[LAST_AS_OF_FALG]="Y"&&V_SM_JOB_INFO_LOG_SNAP[CONFLUENCE_NODE]<>"Y")
			) + 0
			RETURN IF(info_<>0,"#319F4F","#1F1D24")
		lineageTag: aa12a7c9-6891-4a5c-b629-113056526ebb

	-- 流程持续时间超限颜色：如果实际总持续时间大于计划总持续时间返回红色
	measure FLOW_DURATION_COLOR = IF(SUM(V_SM_FLOW_INFO_LOG_SNAP[ACTUAL_DURANTIONS])>SUM(V_SM_FLOW_INFO_LOG_SNAP[SCHEDULE_DURANTIONS]),"#CD3E32")
		lineageTag: 67ec9edb-b102-423f-9a38-31d40ac5ec40

	-- 判断延迟类型：根据Latency_D和Latency_S的标记返回"Duration Latency"/"Scheduled Latency"/"Both Latency"
	measure Latency_Type =
			SWITCH(TRUE(),
			MAX(V_SM_JOB_INFO_LOG_SNAP[Latency_S])<>"Y"&&MAX(V_SM_JOB_INFO_LOG_SNAP[Latency_D])="Y","Duration Latency",
			MAX(V_SM_JOB_INFO_LOG_SNAP[Latency_D])<>"Y"&&MAX(V_SM_JOB_INFO_LOG_SNAP[Latency_S])="Y","Scheduled Latency",
			MAX(V_SM_JOB_INFO_LOG_SNAP[Latency_D])="Y"&&MAX(V_SM_JOB_INFO_LOG_SNAP[Latency_S])="Y","Both Latency")
		lineageTag: 9c24b62b-1321-4536-a931-8200b697d91a

	-- 延迟作业信息颜色：如果有符合条件的延迟作业返回橙色，否则返回深色背景
	measure 'Latency Job_info' =

			var info_=  CALCULATE(
			    COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),
			    FILTER(V_SM_JOB_INFO_LOG_SNAP,V_SM_JOB_INFO_LOG_SNAP[Latency_T]="Y" &&V_SM_JOB_INFO_LOG_SNAP[LAST_AS_OF_FALG]="Y"&&V_SM_JOB_INFO_LOG_SNAP[CONFLUENCE_NODE]<>"Y")
			) + 0
			RETURN IF(info_<>0,"#E49B09","#1F1D24")
		lineageTag: 037ae404-2bd5-48bb-b08e-fba85667868b

	-- 过期作业信息颜色：如果有符合条件的过期作业返回橙色，否则返回深色背景
	measure 'Expiration Job_info' =

			var info_=  CALCULATE(
			    COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),
			    FILTER(V_SM_JOB_INFO_LOG_SNAP,V_SM_JOB_INFO_LOG_SNAP[STATUS]="Expiration" &&V_SM_JOB_INFO_LOG_SNAP[LAST_AS_OF_FALG]="Y"&&V_SM_JOB_INFO_LOG_SNAP[CONFLUENCE_NODE]<>"Y")
			) + 0
			RETURN IF(info_<>0,"#E49B09","#1F1D24")
		lineageTag: 99d122be-fd53-4ab4-8a86-44a4fdb7cd59

	-- 统计总触发作业数量：筛选最新、非未开始、选中流程、非Confluence节点的作业计数
	measure Total_Triggered_Jobs = CALCULATE(COUNT(V_SM_JOB_INFO_LOG_SNAP[JOB_ID]),FILTER(V_SM_JOB_INFO_LOG_SNAP,V_SM_JOB_INFO_LOG_SNAP[latest_]="Y"&&V_SM_JOB_INFO_LOG_SNAP[STATUS]<>"Not Started"&&V_SM_JOB_INFO_LOG_SNAP[FLOW_NAME]=SELECTEDVALUE(V_SM_FLOW_INFO_LOG_SNAP[FLOW_NAME])&&V_SM_JOB_INFO_LOG_SNAP[CONFLUENCE_NODE]<>"Y"))+0
		formatString: 0
		lineageTag: 8d3d0344-9aaa-4771-83da-a6beb11d6106

	-- 成功作业计数（不含零）：不额外+0，用于特殊场景
	measure 'Succeeded_Jobs Without0' = CALCULATE(COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Succeeded"))
		formatString: 0
		lineageTag: 32dc42be-0553-4092-85c6-3fe600b5c691

	-- 成功率（不含零）：不额外+0，用于特殊场景
	measure 'success_rate without0' =

			var s_ = CALCULATE(COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Succeeded"))
			var all_ = CALCULATE(COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]))
			RETURN DIVIDE(s_,all_,0)
		formatString: 0.00%;-0.00%;0.00%
