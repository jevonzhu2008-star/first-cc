table _Measure
	lineageTag: 5e03264d-4f1e-440e-9405-90be650350d2

	-- 计算作业成功率：成功作业数 / 总作业数
	measure success_rate =

			var s_ = CALCULATE(COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Succeeded"))
			var all_ = CALCULATE(COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]))
			RETURN DIVIDE(s_,all_,0) + 0
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: f42f599d-7479-448f-8fd5-637f7864e022

	-- 统计失败作业数量：状态为"Failed"的作业计数
	measure Failed_Jobs = CALCULATE(COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Failed"))+0
		formatString: 0
		lineageTag: f98e1489-e9ab-4e6d-94cc-3081e2becee8

	-- 统计持续时间延迟的作业数量：Latency_D = "Y" 的作业去重计数
	measure Durartion_Latency =

			CALCULATE(DISTINCTCOUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[Latency_D]="Y"))+0
		formatString: 0
		lineageTag: 1cbfe521-29f6-44b9-b35d-3ae737650874

	-- 统计重跑作业数量：Rerun tag = "rerun" 的作业去重计数
	measure Rerun = CALCULATE(DISTINCTCOUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[Rerun tag]="rerun"))
		formatString: 0
		lineageTag: b8c93de4-6a00-4bc0-b3a9-8cfe5a9db211

	-- 计算作业失败率：失败作业数 / 总作业数
	measure Failed_Rate =

			var F_ = CALCULATE(COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Failed"))
			var all_ = CALCULATE(COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]))
			RETURN DIVIDE(F_,all_,0)+0
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b6ba9b7c-f638-40c1-a743-4cacb83e7c33

	-- 计算作业完成率：已完成（成功）作业数 / 总作业数
	measure 'Completion rate' =

			var total_ = COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID])
			var comp_ = CALCULATE(COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Succeeded"))
			RETURN DIVIDE(comp_,total_,0)+0
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 56b28eae-e576-4df3-982d-b1d29e9f1fe9

	-- 动态标题：根据参数选择返回"Job Status By Source"或"Job Status By Flow"
	measure 'Job Status by' =

			VAR _parameter = SELECTEDVALUE('Parameter 2'[Parameter Fields])
			VAR text_ = IF(_parameter = "'Source'[SOURCE]","Source","Flow")
			return  CONCATENATE("Job Status By ",text_)
		lineageTag: bbf9d20f-135a-46ed-a16e-dfe183d288a3

	-- 动态标题：根据参数选择返回"Total Duration By Source"或"Total Duration By Flow"
	measure 'Top 5 Average Duration by' =

			VAR _parameter = SELECTEDVALUE('Parameter 2'[Parameter Fields])
			VAR text_ = IF(_parameter = "'Source'[SOURCE]","Source","Flow")
			return  CONCATENATE("Total Duration By ",text_)
		lineageTag: 0bc059db-05fc-4a30-a740-58e905970129

	-- 动态标题：根据参数选择返回"Failed Rate By Source"或"Failed Rate By Flow"
	measure 'Failed Rate by' =

			VAR _parameter = SELECTEDVALUE('Parameter 2'[Parameter Fields])
			VAR text_ = IF(_parameter = "'Source'[SOURCE]","Source","Flow")
			return  CONCATENATE("Failed Rate By ",text_)
		lineageTag: 0a2c156f-f7ac-4d09-8f94-9524df47db22

	-- 统计计划时间延迟的作业数量：Latency_S = "Y" 的作业去重计数
	measure Scheduled_Latency =

			CALCULATE(DISTINCTCOUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[Latency_S]="Y"))+0
		formatString: 0
		lineageTag: 48a89f5f-09df-4033-a595-e505cbe806cf

	-- 统计每日失败作业数量：按日期筛选状态为"Failed"的作业去重计数
	measure Daily_Failed_Jobs = CALCULATE(DISTINCTCOUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Failed"))+0
		formatString: 0
		lineageTag: 341718c3-d766-466a-b0c3-83c05d56c741

	-- 下次计划开始时间（预留度量）
	measure Next_scheduled_start
		lineageTag: 5bcf89e8-9e45-4148-a858-008ba1f85982

	-- 判断流程整体状态：根据所有作业是否全部成功/全部未开始/部分进行中返回不同状态
	measure Flow_Status =

			var count_all= DISTINCTCOUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID])
			VAR succeeded_ = CALCULATE(DISTINCTCOUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Succeeded"))
			VAR not_started = CALCULATE(DISTINCTCOUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="No Started"))
			return SWITCH(TRUE(),
			count_all=succeeded_,"Succeeded",
			not_started=count_all,"No Started",
			"InProgress")
		lineageTag: 8dbb796c-c486-455a-bf15-e653895da046

	-- 成功阈值标记（预留度量）
	measure Succeeded_threshold
		lineageTag: ce67ae6d-908f-424b-b207-96aab81bb9b2

	-- 获取第一个作业的开始时间：格式化为"yyyy-mm-dd HH:MM:SS"
	measure first_job_time = ```
			 VAR DT = FORMAT(MIN('V_SM_JOB_INFO_LOG_SNAP'[START_TS]),"HH:MM:SS")
			 VAR DATES = FORMAT(MIN('V_SM_JOB_INFO_LOG_SNAP'[START_TS]),"yyyy-mm-dd")
			 RETURN
			 IF( DT = BLANK() ,"Not Started",
			    --DATES & UNICHAR(10) & DT
			    DATES & "  " & DT
			 )
			```
		lineageTag: 06d741a4-8332-4c74-a01a-2b758870bfa7

	-- 计算快照成功率：仅统计状态为成功/失败的已完成作业，排除未开始等状态
	measure success_rate_snap =

			VAR s_ =
			    CALCULATE (
			        COUNT ( 'V_SM_JOB_INFO_LOG_SNAP'[JOB_ID] ),
			        FILTER (
			            'V_SM_JOB_INFO_LOG_SNAP',
			            'V_SM_JOB_INFO_LOG_SNAP'[STATUS] = "Succeeded"
			        )
			    )
			VAR all_ =
			    CALCULATE (
			        COUNT ( 'V_SM_JOB_INFO_LOG_SNAP'[JOB_ID] ),
			        FILTER (
			            'V_SM_JOB_INFO_LOG_SNAP',
			            'V_SM_JOB_INFO_LOG_SNAP'[STATUS]
			                IN {
			                    "Succeeded",
			                    "Failed"
			                }
			        )
			    )
			RETURN
			    DIVIDE (
			        s_,
			        all_,
			        0
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8fada7e9-dabb-4a74-a59f-1701afbab0cd

	-- 总作业计数快照：统计V_SM_JOB_INFO_LOG_SNAP中的所有作业计数
	measure Jobs_snap = COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]) + 0
		formatString: 0
		lineageTag: d63e9a41-0e53-4a09-b591-f3ed54ad7ff6

	-- 计算实际持续时间与计划持续时间的差值平均值：(实际平均 - 计划平均)
	measure durations_diff_snap = AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS])-AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[SCHEDULE_DURANTIONS])
		lineageTag: f6a25de6-59e0-4c5f-b8a8-a1da95cff323

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	-- 计算成功作业的平均实际持续时间：仅筛选状态为"Succeeded"的作业
	measure Average_succeeded = CALCULATE(AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Succeeded"))
		lineageTag: 4666a1d3-c991-4bd0-8003-cfe29b3ae31e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	-- 计算失败作业的平均实际持续时间：仅筛选状态为"Failed"的作业
	measure Average_Failed = CALCULATE(AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Failed"))
		lineageTag: 9b69d5e9-a3ca-4e90-9a67-28a11dcc0300

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	-- 计算运行中作业的平均实际持续时间：仅筛选状态为"InProgress"的作业
	measure Average_running = CALCULATE(AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="InProgress"))
		lineageTag: b20d54af-f117-4848-b9fb-44384775be0a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	-- 计算按作业分组的持续时间标准差：转换为小时单位
	measure STD_by_job =

			CALCULATE(STDEV.P('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS])/3600,ALL('V_SM_JOB_INFO_LOG_SNAP'[JOB_NAME]))
		formatString: 0.0000
		lineageTag: 1d926df6-7422-4d14-872b-526d1aa356cb

	-- 每日格式化颜色判断：根据(平均持续时间 / 标准差)的比值返回颜色，异常值标为橙色
	measure Daily_formatting = ```

			 VAR p_ = DIVIDE(AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]),[STD_by_job],0)
			 RETURN IF(p_>=2||p_<=0.25,"#FBB51F","#08B1A8")
			```
		lineageTag: 7dbd5db8-697b-496b-a9fb-fd449bcba580

	-- 开始颜色条件格式：如果最大Latency_S = "Y"则返回橙色
	measure start_color = IF(MAX('V_SM_JOB_INFO_LOG_SNAP'[Latency_S])="Y","#FBB51F")
		lineageTag: 81b51cfe-105e-4b3f-b6ae-30dcf743f83b

	-- 统计成功作业数量：状态为"Succeeded"的作业计数
	measure Succeeded_Jobs = CALCULATE(COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),FILTER('V_SM_JOB_INFO_LOG_SNAP','V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Succeeded"))+0
		formatString: 0
		lineageTag: 3c3f2b79-7443-41ad-99b3-69691c55e71c

	-- 计算成功率与阈值(99.5%)的差值：用于判断是否超过阈值
	measure over_th = [success_rate_snap]-0.995
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 11e504d5-1aa3-41d5-8cd7-f8e236bfcebd

	-- 去重作业计数快照：对JOB_ID进行去重计数
	measure Jobs_snap_distinct = DISTINCTCOUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID])+0
		formatString: 0
		lineageTag: 1ebea91b-0b08-44c4-8014-dacff8bc0bc7

	-- 获取所有作业中的最大日期：用于显示最新数据日期
	measure Max_as_of_day = CALCULATE(MAX('V_SM_JOB_INFO_LOG_SNAP'[AS_OF_DAY]),ALL('V_SM_JOB_INFO_LOG_SNAP'))
		formatString: General Date
		lineageTag: 3a605c5a-73b1-4fef-ac93-682e176fdb0a

	-- 周范围标题生成：生成当前周和对比周的日期范围文本
	measure week_title =

			var ex_time = MAX(Week_Table[Date])
			var ex_time_min =MIN(Week_Table[Date])
			var text_1 = FORMAT(ex_time,"mm/dd/yyyy")
			var text_2 = CONCATENATE(FORMAT(ex_time_min,"mm/dd/yyyy"), " - ")
			var ex_time_7 = MAX(Week_Table[Date])-7
			var ex_time_min_7 =MIN(Week_Table[Date])-7
			var text_3 = FORMAT(ex_time_7,"mm/dd/yyyy")
			var text_4 = CONCATENATE(" VS " ,CONCATENATE(FORMAT(ex_time_min_7,"mm/dd/yyyy"), " - "))
			var text_5 = CONCATENATE(text_2,text_1)
			VAR TEXT_6 = CONCATENATE(text_4,TEXT_3)
			RETURN CONCATENATE(text_5,TEXT_6
			)
		lineageTag: 7233a6c6-6b07-43ec-9cb7-fea1f25b5eb8

	-- 按日期分组的平均持续时间标准差：转换为小时单位
	measure STD_by_Day =

			STDEVX.S(ALLSELECTED(V_SM_JOB_INFO_LOG_SNAP[AS_OF_DAY]),[Average_Duration])/3600
		lineageTag: 1d5ac26d-d625-46a0-93ae-0cc79ad29176

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	-- 按日期计算平均持续时间：转换为小时单位
	measure Average_by_Day = CALCULATE(AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS])/3600,ALLSELECTED('V_SM_JOB_INFO_LOG_SNAP'[AS_OF_DAY]))
		formatString: 0
		lineageTag: dbd3215f-a344-47d0-9fff-dfe09d276e95

	-- 范围格式化颜色判断：根据(当日平均与总体平均差值的绝对值)是否大于标准差返回颜色
	measure range_formatting = ```

			 VAR p_ = ABS(AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS])-[Average_by_Day])-[STD_by_Day]
			 RETURN IF(p_>=0,"#08B1A8","#FBB51F")
			```
		lineageTag: be12bf53-af41-4e60-ae76-306f80e55ce7

	-- 按来源计算平均持续时间：总和除以来源数，转换为小时单位
	measure Average_By_source = DIVIDE(SUM('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS])/3600,COUNT('V_SM_JOB_INFO_LOG_SNAP'[SOURCE]),0)
		lineageTag: aea7c051-54e5-4698-b3d4-656a40eac718

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	-- 按来源计算平均持续时间的标准差：对每个来源的总和计算标准差
	measure Std_source = ```

			VAR A=
			    ADDCOLUMNS(
			        ALL('V_SM_JOB_INFO_LOG_SNAP'[SOURCE]),
			        "@SUM", CALCULATE(SUM('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS])/3600)
			    )
			VAR RESULT =
			CALCULATE(
			    STDEVX.S(A,[@SUM]),ALLSELECTED('V_SM_JOB_INFO_LOG_SNAP'[SOURCE]))
			RETURN
			    RESULT
			```
		lineageTag: ca1263c9-bb81-4e97-952f-28a678c69bf9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	-- 格式化最大持续时间：将最大持续时间秒数转换为"Xh Xm Xs"格式显示
	measure MAX_durations2 =

			VAR DIF = MAX('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]) + 0
			VAR HOURS = INT(DIF/3600)
			VAR MINUTES =INT(MOD(DIF ,3600 )/ 60)
			VAR SECONDS = ROUNDDOWN(MOD(DIF-MINUTES*60,3600),0)
			RETURN
			SWITCH(
			    TRUE(),
			    HOURS = 0 && MINUTES <> 0  ,MINUTES & "m" & SECONDS & "s",
			    HOURS = 0 && MINUTES = 0 , SECONDS & "s",
			    HOURS&"h" & MINUTES & "m" & SECONDS & "s"
			)
		lineageTag: eee781b9-bdcc-4b33-9d03-be05c2cf7172

	-- 格式化最小持续时间：将最小持续时间秒数转换为"Xh Xm Xs"格式显示
	measure MIN_durations2 =

			VAR DIF =  MIN('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]) + 0
			VAR HOURS = INT(DIF/3600)
			VAR MINUTES =INT(MOD(DIF ,3600 )/ 60)
			VAR SECONDS = ROUNDDOWN(MOD(DIF-MINUTES*60,3600),0)
			RETURN
			SWITCH(
			    TRUE(),
			    HOURS = 0 && MINUTES <> 0  ,MINUTES & "m" & SECONDS & "s",
			    HOURS = 0 && MINUTES = 0 , SECONDS & "s",
			    HOURS&"h" & MINUTES & "m" & SECONDS & "s"
			)
		lineageTag: 7d671b42-a57e-499d-abf3-696b3462fc2b

	-- 统计当前运行中作业数量：筛选状态为"InProgress"的作业计数
	measure Cnt_Running_Job =

			CALCULATE(
			    COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),
			    'V_SM_JOB_INFO_LOG_SNAP'[STATUS] = "InProgress"
			) + 0
		formatString: 0
