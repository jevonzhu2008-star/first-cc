	-- 统计最新失败作业信息数量：筛选状态失败、最新标记、非Confluence节点的作业计数
	measure 'Failed Job_info' =

			CALCULATE(
			    COUNT('V_SM_JOB_INFO_LOG_SNAP'[JOB_ID]),
			    FILTER(V_SM_JOB_INFO_LOG_SNAP,'V_SM_JOB_INFO_LOG_SNAP'[STATUS] = "Failed" &&V_SM_JOB_INFO_LOG_SNAP[LAST_AS_OF_FALG]="Y"&&V_SM_JOB_INFO_LOG_SNAP[CONFLUENCE_NODE]<>"Y")
			) + 0
		formatString: 0
		lineageTag: c48081a8-3740-4e72-b6ff-da54436cfb69

	-- 失败作业信息条件格式颜色：如果有失败作业返回红色，否则返回深色背景
	measure 'Failed Job_info_color' =

			IF( [Failed Job_info] <> 0 , "#cd3e32","#1f1d24")
		lineageTag: 74f22f01-415d-4eda-92fd-c3a2fd8dcd06

	-- 计算所有作业的平均持续时间
	measure Average_Duration = AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS])
		lineageTag: 1338fb70-b057-463f-aa70-3b64898246c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	-- 计算Y轴最大值：按作业名称分组平均后取最大值，增加10%边距，转换为分钟
	measure Max_Y = ```

			VAR M = ADDCOLUMNS(
			           SUMMARIZECOLUMNS('V_SM_JOB_INFO_LOG_SNAP'[JOB_NAME],'V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]),
			           "@AVG",CALCULATE( AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]))
			)
			VAR maxs = MAXX( M , [@AVG] )
			VAR MAXS_ = maxs *1.1
			RETURN
			    ROUND(ABS(MAXS_), 0)/60

			```
		formatString: 0
		lineageTag: fa95b8b7-e558-4c2b-9f0a-543276f4cca9

	-- 计算Y轴最小值：按作业名称分组平均后取最小值，减少10%边距，转换为分钟
	measure Min_Y = ```

			VAR M = ADDCOLUMNS(
			           SUMMARIZECOLUMNS('V_SM_JOB_INFO_LOG_SNAP'[JOB_NAME],'V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]),
			           "@AVG",CALCULATE( AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]))
			)
			VAR maxs = MINX( M , [@AVG] )
			VAR MAXS_ = maxs *0.9
			RETURN
			  ROUND(ABS(MAXS_), 0)/60

			```
		lineageTag: 67d2351a-8863-4898-a7d1-21b8c432010e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	-- 格式化总实际持续时间：将总秒数转换为"Xh Xm Xs"格式显示
	measure sum_v_durations = ```

			VAR DIF =SUM('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]) + 0
			VAR HOURS = INT(DIF/3600)
			VAR MINUTES =INT(MOD(DIF ,3600 )/ 60)
			VAR SECONDS = MOD(DIF-MINUTES*60,3600)
			RETURN
			SWITCH(
			    TRUE(),
			    HOURS = 0 && MINUTES <> 0  ,MINUTES & "m" & SECONDS & "s",
			    HOURS = 0 && MINUTES = 0 , SECONDS & "s",
			    HOURS&"h" & MINUTES & "m" & SECONDS & "s"
			)

