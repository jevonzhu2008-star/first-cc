table 'Databricks Log'
	lineageTag: 9b148220-4591-48d8-84f7-05f7cb30319c

	measure 'Data As Of Databricks Log' =
			
			// var max_ = CALCULATE(MAX('API Job Log'[CREATE_TIME]),ALL('API Job Log'))
			var max_ = CALCULATE(MAX('Databricks Log'[CREATE_TIME]),ALL('Databricks Log'))
			return CONCATENATE("Data As Of: UTC ",max_)
