table ADFPIPELINERUN
	lineageTag: e2e74723-e052-4125-b2f1-fe7a987b0660

	measure 'Data As Of Pipeline' =
			
			// var max_ = CALCULATE(MAX('API Job Log'[CREATE_TIME]),ALL('API Job Log'))
			var max_ = CALCULATE(MAX('ADFPIPELINERUN'[CREATE_TIME]),ALL(ADFPIPELINERUN))
			return CONCATENATE("Data As Of: UTC ",max_)
