	measure 'Actual Durations AVG' = ```
			
			VAR MAXTIME = 
			        CALCULATE(
			                MAX('V_SM_JOB_INFO_LOG_SNAP'[END_TS]),
			                'V_SM_JOB_INFO_LOG_SNAP'[STATUS] = "Succeeded"
			            )   
			
			VAR MINTIME =  
			        CALCULATE(
			                MIN('V_SM_JOB_INFO_LOG_SNAP'[END_TS]),
			                'V_SM_JOB_INFO_LOG_SNAP'[STATUS] = "Succeeded"
			            )   
			VAR DIF = 
			        // DATEDIFF(MINTIME,MAXTIME,SECOND)
			AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS])
			VAR HOURS = INT(DIF/3600)
			VAR MINUTES =INT(MOD(DIF ,3600 )/ 60)
			VAR SECONDS = ROUNDDOWN(MOD(DIF-MINUTES*60,3600),0)
			RETURN
			SWITCH(
			    TRUE(),
			    HOURS = 0 && MINUTES = 0 && SECONDS = 0  , "0",
			    HOURS = 0 && MINUTES <> 0  ,MINUTES & "m" & SECONDS & "s",
			    HOURS = 0 && MINUTES = 0 , SECONDS & "s",
			    HOURS&"h" & MINUTES & "m" & SECONDS & "s"
			)
			```
		lineageTag: c2d2a321-cafd-4668-807a-0cff68a09c44

		changedProperty = IsHidden

