	column Job_ = ```
			
			
			var status_ = CALCULATE(VALUES(V_SM_JOB_INFO_LOG_SNAP[STATUS]),FILTER(ALLEXCEPT(V_SM_JOB_INFO_LOG_SNAP,V_SM_JOB_INFO_LOG_SNAP[JOB_ID],V_SM_JOB_INFO_LOG_SNAP[AS_OF_DAY]),V_SM_JOB_INFO_LOG_SNAP[LAST_AS_OF_FALG]="Y"&&V_SM_JOB_INFO_LOG_SNAP[D_con]>0))
			VAR icon_ = 
			SWITCH(TRUE(),
			status_="Succeeded",[Succeeded],
			status_="Inprogress",[InProgress],
			status_="Not Started",[Not started],
			status_="Failed",[Failed],
			status_="Expiration",[expiration],
			status_="Cancelled",[cancelled])
			RETURN icon_ & V_SM_JOB_INFO_LOG_SNAP[JOB_NAME]
