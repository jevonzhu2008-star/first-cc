	column 'STATUS Icon' = ```
			
			VAR CURRENT_ = 
			SWITCH(TRUE(),
			'V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Succeeded",[Succeeded],
			'V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Inprogress",[InProgress],
			'V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Not Started",[Not started],
			'V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Failed",[Failed],
			'V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Expiration",[expiration],
			'V_SM_JOB_INFO_LOG_SNAP'[STATUS]="Cancelled",[cancelled])
			RETURN CONCATENATE(CURRENT_,"  "&'V_SM_JOB_INFO_LOG_SNAP'[STATUS])
			```
