table V_SM_JOB_INFO_LOG_SNAP
	lineageTag: 007ecd64-965e-4d6c-b058-adc61ad05093

	measure Avg_Run_Time = ```
			
			VAR DIF = AVERAGE('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]) + 0
			VAR HOURS = INT(DIF/3600)
			VAR MINUTES =INT(MOD(DIF ,3600 )/ 60)
			VAR SECONDS = ROUNDDOWN(MOD(DIF-MINUTES*60,3600),0)
			RETURN
			SWITCH(
			    TRUE(),
			    HOURS = 0 && MINUTES <> 0  ,MINUTES & "m" & SECONDS & "s",
			    HOURS = 0 && MINUTES = 0 , SECONDS & "s",
			    HOURS&"h" & MINUTES & "m" & SECONDS & "s"
			)
			
			```
		lineageTag: 8573edb5-29f3-49f2-8609-c3b3807f4ed0

		changedProperty = IsHidden

	measure 'Actual Durations' = ```
			
			VAR DIF = 
			SUM('V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS])
			VAR HOURS = INT(DIF/3600)
			VAR MINUTES =INT(MOD(DIF ,3600 )/ 60)
			VAR SECONDS = ROUNDDOWN(MOD(DIF-MINUTES*60,3600),0)
			RETURN
			SWITCH(
			    TRUE(),
			    HOURS = 0 && MINUTES = 0 && SECONDS = 0  , "0",
			    HOURS = 0 && MINUTES <> 0  ,MINUTES & "m" & SECONDS & "s",
			    HOURS = 0 && MINUTES = 0 , SECONDS & "s",
			    HOURS&"h" & MINUTES & "m" & SECONDS & "s"
			)
			```
		lineageTag: f0cac35b-addc-496a-a006-f7fba7be7192

		changedProperty = IsHidden

