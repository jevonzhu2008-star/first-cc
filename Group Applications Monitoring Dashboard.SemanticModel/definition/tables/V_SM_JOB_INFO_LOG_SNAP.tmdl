	column 'Col_Actual Durations' =
			
			VAR DIF = 'V_SM_JOB_INFO_LOG_SNAP'[ACTUAL_DURANTIONS]
			VAR HOURS = INT(DIF/3600)
			VAR MINUTES =INT(MOD(DIF ,3600 )/ 60)
			VAR SECONDS = ROUNDDOWN(MOD(DIF-MINUTES*60,3600),0)
			RETURN
			SWITCH(
			    TRUE(),
			    HOURS = 0 && MINUTES = 0 && SECONDS = 0  , blank(),
			    HOURS = 0 && MINUTES <> 0  ,MINUTES & "m" & SECONDS & "s",
			    HOURS = 0 && MINUTES = 0 , SECONDS & "s",
			    HOURS&"h" & MINUTES & "m" & SECONDS & "s"
			)
