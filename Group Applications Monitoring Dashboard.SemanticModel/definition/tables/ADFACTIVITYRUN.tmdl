table ADFACTIVITYRUN
	lineageTag: 594e65a6-3797-443e-8a46-416caa9030ea

	measure 'Data As Of Activity' =
			
			// var max_ = CALCULATE(MAX('API Job Log'[CREATE_TIME]),ALL('API Job Log'))
			var max_ = CALCULATE(MAX('ADFACTIVITYRUN'[CREATE_TIME]),ALL(ADFACTIVITYRUN))
			return CONCATENATE("Data As Of: UTC ",max_)
		lineageTag: 7e7dbc41-e8cf-4be6-9327-f215469dec43

