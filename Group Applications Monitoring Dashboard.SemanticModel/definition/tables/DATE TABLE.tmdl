	column Date
		formatString: Long Date
		lineageTag: 196be9a8-2fcc-4064-8667-6cd8ca315235
		summarizeBy: none
		sourceColumn: V_SM_JOB_INFO_LOG_SNAP[AS_OF_DAY]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column ETLSL_DATE =
			VAR etlsl = CALCULATE(DISTINCT(V_SM_JOB_INFO_LOG_SNAP[AS_OF_DAY]),FILTER(V_SM_JOB_INFO_LOG_SNAP,V_SM_JOB_INFO_LOG_SNAP[PROJECT_ID] IN {"P004","P006"}&&V_SM_JOB_INFO_LOG_SNAP[LAST_AS_OF_FALG]="Y"))
			return IF('DATE TABLE'[Date]=etlsl,"Y")
		lineageTag: 84eab142-69e0-4062-8b72-dbb8da12d850
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'DATE TABLE-36cc5483-872a-4c74-be00-5d7e931d02bf' = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(DISTINCT(V_SM_JOB_INFO_LOG_SNAP[AS_OF_DAY]),
				"Year_MONTH",FORMAT([AS_OF_DAY],"MMM-YY"),
				"Number_Year_Month",YEAR([AS_OF_DAY])*100+MONTH([AS_OF_DAY]),
				"WEEK",FORMAT([AS_OF_DAY],"DDD"),
				"WEEKDAY",WEEKDAY([AS_OF_DAY],2),
				"WEEKNUM",WEEKNUM([AS_OF_DAY],2) ,
				"Date_Number",YEAR([AS_OF_DAY])*10000+MONTH([AS_OF_DAY])*100+DAY([AS_OF_DAY]
				))
				
				
				```

	annotation PBI_Id = eeae32719ac74337a0cbfaf7f16a8695

