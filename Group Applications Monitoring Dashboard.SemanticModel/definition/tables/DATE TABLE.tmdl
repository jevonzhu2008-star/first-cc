	column ReportDate =
			
			
			IF('DATE TABLE'[Date] = MAX('DATE TABLE'[Date]),"Today",'DATE TABLE'[Date]& "")
		lineageTag: aee51345-90c8-4d4b-a08b-c41a4ec13bef
