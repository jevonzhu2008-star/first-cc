	partition HelperTable = m
		mode: import
		queryGroup: View
		source =
				let
				    Source = V_SM_JOB_INFO_LOG_SNAP,
				    Project = List.Distinct( Source[PROJECT_NAME] ),
				    Flow = List.Repeat( {List.Distinct( Source[FLOW_NAME] ) }, List.Count(Project) ),
				    Helper = Table.FromColumns(Flow,Project)
				in
				    Helper

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

