"</svg>"
RETURN
svg


Monitor Tag =
VAR textStr = "Monitor"
VAR charWidth = 8
VAR svgWidth = 54 + LEN(textStr) * charWidth
VAR rectW = svgWidth - 2
VAR svg =
"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & svgWidth & "' height='36' viewBox='0 0 " & svgWidth & " 36'>" &
"<rect x='1' y='1' width='" & rectW & "' height='34' rx='17' fill='#FFF7ED' stroke='#F59E0B' stroke-width='1.5'/>" &
"<g transform='translate(14, 10)'>" &
"<path d='M5 1L2 8h2.5l-1 5 5-6.5H6l1.5-5.5z' fill='#F59E0B' stroke='#F59E0B' stroke-width='0.5' stroke-linejoin='round'/>" &
"</g>" &
"<text x='36' y='23' text-anchor='start' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='#D97706'>" & textStr & "</text>" &
"</svg>"
RETURN
svg
